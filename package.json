{
  "name": "agendei-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome lint",
    "format": "biome format --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": "pnpm biome check --write --unsafe"
  },
  "dependencies": {
    "@brazilian-utils/brazilian-utils": "2.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tabler/icons-react": "3.46.0",
    "better-auth": "1.7.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.87.0",
    "react-router-dom": "7.18.0",
    "use-mask-input": "3.14.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.12",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "download"
    }
  }
}
